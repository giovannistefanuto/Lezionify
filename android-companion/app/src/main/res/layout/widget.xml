<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="10dp"
    android:background="@drawable/widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical">
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/widget_logo" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="9dp" android:text="@string/widget_brand"
            android:textColor="@color/widget_text" android:textSize="16sp"
            android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_refresh"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="3dp"
            android:background="@drawable/widget_action" android:src="@drawable/widget_sync"
            android:scaleType="center" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_metrics"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="3" android:orientation="vertical" android:gravity="center_vertical"
            android:layout_marginEnd="10dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
            android:paddingStart="10dp" android:paddingEnd="9dp"
            android:background="@drawable/widget_hero">
            <TextView style="@style/WidgetMetricLabel"
                android:layout_width="match_parent" android:layout_height="18dp"
                android:text="@string/widget_today" android:textColor="@color/widget_hero_muted" />
            <TextView android:id="@+id/widget_today" style="@style/WidgetMetricValue"
                android:layout_width="match_parent" android:layout_height="38dp"
                android:autoSizeMaxTextSize="36sp" android:textColor="@color/widget_hero_text" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="2" android:orientation="vertical" android:gravity="center_vertical">
            <TextView style="@style/WidgetMetricLabel"
                android:layout_width="match_parent" android:layout_height="16dp"
                android:text="@string/widget_week" />
            <TextView android:id="@+id/widget_week" style="@style/WidgetMetricValue"
                android:layout_width="match_parent" android:layout_height="18dp" />
            <TextView style="@style/WidgetMetricLabel"
                android:layout_width="match_parent" android:layout_height="16dp"
                android:layout_marginTop="3dp" android:text="@string/widget_month" />
            <TextView android:id="@+id/widget_month" style="@style/WidgetMetricValue"
                android:layout_width="match_parent" android:layout_height="18dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_empty" style="@style/WidgetMetricValue"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:includeFontPadding="true" android:maxLines="2" android:autoSizeMaxTextSize="18sp"
        android:text="@string/widget_no_data" />

    <LinearLayout android:id="@+id/widget_courses"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginBottom="5dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/widget_course_heading" style="@style/WidgetMetricValue"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:autoSizeMaxTextSize="13sp"
                android:text="@string/widget_courses" />
            <TextView android:id="@+id/widget_total" style="@style/WidgetMetricValue"
                android:layout_width="80dp" android:layout_height="22dp" android:gravity="center"
                android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp"
                android:textColor="@color/widget_accent" android:background="@drawable/widget_total" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_course_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/widget_more" style="@style/WidgetMetricLabel"
            android:layout_width="match_parent" android:layout_height="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/widget_footer" style="@style/WidgetMetricValue"
        android:layout_width="match_parent" android:layout_height="16dp"
        android:autoSizeMaxTextSize="12sp" android:textColor="@color/widget_muted"
        android:text="@string/widget_open" />
</LinearLayout>
