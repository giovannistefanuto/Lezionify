<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course"
    android:layout_width="match_parent" android:layout_height="23dp"
    android:orientation="vertical" android:importantForAccessibility="yes">
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/widget_rule" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/widget_course_name" style="@style/WidgetMetricLabel"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:textColor="@color/widget_text"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_course_remaining" style="@style/WidgetMetricValue"
            android:layout_width="52dp" android:layout_height="match_parent"
            android:gravity="end|center_vertical" android:autoSizeMaxTextSize="13sp"
            android:textColor="@color/widget_accent" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
