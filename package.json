{
  "name": "lezionify",
  "version": "0.1.0",
  "description": "App desktop local-first per trasformare registrazioni universitarie in materiale di studio strutturato.",
  "author": "Giovanni",
  "private": true,
  "keywords": [
    "electron",
    "education",
    "local-first",
    "transcription",
    "study-tools"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giovannistefanuto/Lezionify.git"
  },
  "homepage": "https://github.com/giovannistefanuto/Lezionify#readme",
  "bugs": {
    "url": "https://github.com/giovannistefanuto/Lezionify/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "electron-vite build && electron-builder --win",
    "package:portable": "electron-vite build && electron-builder --win portable",
    "package:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.node.json && tsc --noEmit --pretty false -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"shared/**/*.ts\"",
    "test": "vitest run",
    "test:benchmark": "python -m unittest discover -s tests/python -p \"test_*.py\"",
    "test:hooks": "node tools/run_hook_regressions.cjs",
    "test:pdf-export": "node tools/run_pdf_export_regressions.cjs",
    "test:qna-real": "node tools/run_real_qna.cjs",
    "test:qna-benchmark": "node --test tests/node/qna-benchmark.node.mjs tests/node/qna-private.node.mjs",
    "benchmark:qna": "node tools/qna_benchmark.mjs",
    "benchmark:gemini-transcription": "electron tools/run_gemini_benchmark_with_app_keys.cjs",
    "audit:styles": "node tools/audit_styles.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:benchmark && npm run test:qna-benchmark && npm run test:hooks && npm run build && npm run test:pdf-export"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "ffmpeg-static": "^5.3.0",
    "katex": "^0.18.4",
    "mermaid": "11.17.2",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
